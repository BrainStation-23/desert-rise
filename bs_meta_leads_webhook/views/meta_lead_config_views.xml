<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_meta_lead_config_form" model="ir.ui.view">
            <field name="name">meta.lead.config.form</field>
            <field name="model">meta.lead.config</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button"
                                    icon="fa-users"
                                    type="object"
                                    name="action_view_leads">
                                <field name="lead_count" widget="statinfo" string="Leads"/>
                            </button>
                            <button class="oe_stat_button"
                                    icon="fa-facebook"
                                    type="object"
                                    name="action_oauth_start"
                                    string="Connect with Meta"/>
                        </div>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                                invisible="active"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="e.g. Main Facebook Page — Contact Form"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Meta Configuration">
                                <field name="page_id"/>
                                <field name="form_id"/>
                                <field name="page_access_token" password="True"/>
                            </group>
                            <group string="CRM Defaults">
                                <field name="lead_type"/>
                                <field name="team_id"/>
                                <field name="user_id"/>
                                <field name="stage_id"/>
                                <field name="tag_ids" widget="many2many_tags"/>
                            </group>
                        </group>
                        <group string="UTM Tracking">
                            <group>
                                <field name="campaign_id"/>
                                <field name="medium_id"/>
                                <field name="source_id"/>
                            </group>
                            <group>
                                <field name="last_lead_received"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Field Mapping (JSON)">
                                <field name="field_mapping" widget="ace"
                                       options="{'mode': 'javascript'}"
                                       placeholder='{"full_name": "contact_name", "email": "email_from", "phone_number": "phone"}'/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_meta_lead_config_list" model="ir.ui.view">
            <field name="name">meta.lead.config.list</field>
            <field name="model">meta.lead.config</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="page_id"/>
                    <field name="form_id"/>
                    <field name="lead_type"/>
                    <field name="team_id"/>
                    <field name="lead_count"/>
                    <field name="last_lead_received"/>
                    <field name="active" column_invisible="True"/>
                </list>
            </field>
        </record>

        <record id="action_meta_lead_config" model="ir.actions.act_window">
            <field name="name">Meta Lead Configurations</field>
            <field name="res_model">meta.lead.config</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
